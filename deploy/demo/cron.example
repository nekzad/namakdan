# Namakdan public demo: cron alternative to demo/systemd/ (pick one, not both).
# crontab -e as a user in the docker group. CRON_TZ needs cronie or Vixie
# cron; on a host whose clock is not UTC without CRON_TZ, adjust the hour.
# Paths assume the clone is /opt/namakdan (deploy directory /opt/namakdan/deploy).
# Cron does not read demo/reset.env: set the optional variables here instead.
CRON_TZ=UTC
DEMO_COMPOSE_DIR=/opt/namakdan/deploy
# DEMO_HEALTH_URL=https://demo.example.test/api/v1/health/ready
# DEMO_ALERT_URL=https://ntfy.sh/<your-private-topic>
0 3 * * * /opt/namakdan/deploy/demo/reset-demo.sh >>/var/log/namakdan-demo-reset.log 2>&1
# Hourly watchdog: alerts (DEMO_ALERT_URL) and exits non-zero when the last
# good reset is older than DEMO_RESET_MAX_AGE_HOURS (default 26).
17 * * * * /opt/namakdan/deploy/demo/reset-demo.sh --check >>/var/log/namakdan-demo-reset.log 2>&1
